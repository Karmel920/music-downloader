{
  "manifest_version": 3,
  "name": "YT MP3 Downloader",
  "version": "1.1.0",
  "description": "Pobieraj MP3 320 kbps z YouTube przez lokalny lub zdalny serwer yt-dlp.",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT MP3 Downloader"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://music.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
